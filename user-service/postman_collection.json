{
  "info": {
    "name": "User Service - POS",
    "description": "Collection untuk test API user-service. Body sengaja dikosongkan (kecuali 1 contoh format di Create User), isi sendiri sesuai kebutuhan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081/api/v1"
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "role_id",
      "value": "",
      "description": "1 = Manager, 2 = Keeper (sesuai urutan seeder)"
    },
    {
      "key": "user_role_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get All",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users?page=&limit=&search=&sort_by=&sort_order=",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "" },
                { "key": "limit", "value": "" },
                { "key": "search", "value": "" },
                { "key": "sort_by", "value": "" },
                { "key": "sort_order", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Delete By ID",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Get By Role Name",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users/role/",
              "host": ["{{base_url}}"],
              "path": ["users", "role", ""]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "description": "Contoh format body (values di bawah cuma contoh, ganti sesuai data yang mau kamu kirim). Field wajib diisi: name, email, password. phone & photo boleh dikosongkan.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"081234567890\",\n  \"photo\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Edit User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"\",\n  \"password\": \"\",\n  \"phone\": \"\",\n  \"photo\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Upload Photo User",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/upload/photo",
              "host": ["{{base_url}}"],
              "path": ["upload", "photo"]
            }
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Get All Roles",
          "request": {
            "description": "Daftar semua role yang ada di sistem (master data), bukan cuma yang lagi di-assign ke user.",
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/roles",
              "host": ["{{base_url}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "Get Role By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/roles/{{role_id}}",
              "host": ["{{base_url}}"],
              "path": ["roles", "{{role_id}}"]
            }
          }
        },
        {
          "name": "Create Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/roles",
              "host": ["{{base_url}}"],
              "path": ["roles"]
            }
          }
        },
        {
          "name": "Update Role",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/roles/{{role_id}}",
              "host": ["{{base_url}}"],
              "path": ["roles", "{{role_id}}"]
            }
          }
        },
        {
          "name": "Delete Role",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/roles/{{role_id}}",
              "host": ["{{base_url}}"],
              "path": ["roles", "{{role_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Assign Role",
      "item": [
        {
          "name": "Edit Assign User Role",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 0,\n  \"role_id\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/assign-role/{{user_role_id}}",
              "host": ["{{base_url}}"],
              "path": ["assign-role", "{{user_role_id}}"]
            }
          }
        },
        {
          "name": "Get All Assign Role",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/assign-role?page=&limit=&search=&sort_by=&sort_order=",
              "host": ["{{base_url}}"],
              "path": ["assign-role"],
              "query": [
                { "key": "page", "value": "" },
                { "key": "limit", "value": "" },
                { "key": "search", "value": "" },
                { "key": "sort_by", "value": "" },
                { "key": "sort_order", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Assign Role By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/assign-role/{{user_role_id}}",
              "host": ["{{base_url}}"],
              "path": ["assign-role", "{{user_role_id}}"]
            }
          }
        },
        {
          "name": "Create Assign User Role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 0,\n  \"role_id\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/assign-role",
              "host": ["{{base_url}}"],
              "path": ["assign-role"]
            }
          }
        }
      ]
    }
  ]
}
